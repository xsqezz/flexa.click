<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Flexa" parent="android:Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@color/flexa_surface</item>
        <item name="android:colorPrimary">@color/flexa_pine</item>
        <item name="android:colorAccent">@color/flexa_pine</item>
        <item name="android:colorControlActivated">@color/flexa_pine</item>
        <item name="android:textColorPrimary">@color/flexa_text</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:alertDialogTheme">@style/Theme.Flexa.Dialog</item>
    </style>

    <style name="Theme.Flexa.Dialog" parent="android:Theme.DeviceDefault.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/flexa_pine</item>
        <item name="android:textColorPrimary">@color/flexa_text</item>
        <item name="android:textColorSecondary">@color/flexa_text</item>
    </style>

    <style name="Theme.Flexa.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/flexa_pine</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Flexa</item>
    </style>
</resources>
