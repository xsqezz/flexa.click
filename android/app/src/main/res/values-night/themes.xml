<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Flexa" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/flexa_surface</item>
        <item name="android:colorPrimary">@color/flexa_pine</item>
        <item name="android:colorAccent">#7CC59A</item>
        <item name="android:colorControlActivated">#7CC59A</item>
        <item name="android:textColorPrimary">@color/flexa_text</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:alertDialogTheme">@style/Theme.Flexa.Dialog</item>
    </style>

    <style name="Theme.Flexa.Dialog" parent="android:Theme.DeviceDefault.Dialog.Alert">
        <item name="android:colorAccent">#7CC59A</item>
        <item name="android:textColorPrimary">@color/flexa_text</item>
        <item name="android:textColorSecondary">@color/flexa_text</item>
    </style>
</resources>
